# SocialWall – Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase
# Get these from: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Wall toggle
# Set to "false" to disable dedica submission (quiz + leaderboard still work).
# Omit or set to "true" to enable (default).
NEXT_PUBLIC_DEDICA_ENABLED=true

# Admin panel password — protects /admin
# Choose a strong password and set it in Vercel env vars too.
NEXT_PUBLIC_ADMIN_PASSWORD=xxxxxxxxxxxxx
